<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox fx:controller="com.example.alancito.controllers.LoginController"
      xmlns:fx="http://javafx.com/fxml" alignment="CENTER" spacing="15">
    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

    <Label text="Inicio de Sesión" style="-fx-font-size: 20px;"/>
    <TextField fx:id="emailField" promptText="Correo (@ y .)"/>
    <PasswordField fx:id="passwordField" promptText="Contraseña (mín 6)"/>
    <Label fx:id="errorLabel" textFill="RED"/>
    <Button text="Entrar" onAction="#handleLogin"/>
</VBox>